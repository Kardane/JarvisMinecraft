{
  "name": "@jarvisminecraft/brain",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test:protocol": "node ./scripts/validate-protocol.mjs",
    "test": "npm run build && node --test ./test/ai/*.test.mjs ./test/core/*.test.mjs ./test/ops/*.test.mjs ./test/server/*.test.mjs",
    "test:server": "npm run build && node --test ./test/server/*.test.mjs",
    "check": "npm run check:contract && npm run typecheck && npm run test:protocol && npm test",
    "start": "node ./dist/server/main.js",
    "generate:contract": "node ./scripts/generate-contract.mjs",
    "check:contract": "node ./scripts/generate-contract.mjs --check"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "openai": "7.22.0",
    "ws": "8.21.3",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "typescript": "5.9.2"
  }
}
