# JarvisMinecraft runtime policy settings for Fabric / NeoForge.
# Provider credentials remain in environment variables/system properties and
# are intentionally not stored here.
#
# List values use | as the separator.

# PASSIVE: wake-word/session only. ACTIVE: may initiate from allowed public chat.
jarvis.interaction.mode=PASSIVE
jarvis.interaction.wake-words=자비스|jarvis|재비스
jarvis.interaction.follow-up-seconds=120

jarvis.interaction.audience.mode=OP
jarvis.interaction.audience.whitelist=
jarvis.interaction.audience.blacklist=

# ACTIVE-mode proactive settings.
jarvis.interaction.proactive.context-messages=12
# Server-wide cooldown after a proactive conversation starts.
jarvis.interaction.proactive.cooldown-seconds=15
# Minimum Jev START_CONVERSATION confidence.
jarvis.interaction.proactive.confidence-threshold=0.75

jarvis.model.name=gpt-6-luna
jarvis.model.reasoning.mode=AUTO
jarvis.model.reasoning.fallback=MEDIUM

# Optional operator-defined prompt context. Files remain under
# config/jarvisminecraft/{persona.md,knowledge/*.md}.
jarvis.personality.enabled=false
jarvis.knowledge.enabled=false
jarvis.knowledge.max-files=32
jarvis.knowledge.max-file-bytes=32768
jarvis.knowledge.max-total-bytes=131072

# Legacy Minecraft ampersand codes are supported in the prefix only.
# Example: jarvis.response.prefix=&5[JARVIS]&r 
jarvis.response.prefix=[JARVIS] 
jarvis.response.waiting-message.enabled=true
jarvis.response.waiting-message.threshold-ms=1800
jarvis.response.waiting-message.messages=잠시만요.|확인해볼게요.|서버 상태를 살펴보고 있어요.

jarvis.response.sound.enabled=false
jarvis.response.sound.id=minecraft:block.note_block.pling
jarvis.response.sound.volume=1.0
jarvis.response.sound.pitch=1.0

# READ_TALK: read-only Tools only.
# EXECUTE_LITE: read-only + explicitly allowed LOW-risk state-changing Tools.
# EXECUTE: read-only + explicitly allowed state-changing Tools.
jarvis.execution.mode=READ_TALK
jarvis.execution.actors=OP

# Tool wire names use | as the separator.
# Example: jarvis.execution.lite.allow-tools=teleport_staff|weather_set|time_set
jarvis.execution.lite.allow-tools=
jarvis.execution.lite.deny-tools=
jarvis.execution.full.allow-tools=
jarvis.execution.full.deny-tools=

# Enables schedule_action. Pending schedules are memory-only.
jarvis.scheduling.enabled=false
jarvis.scheduling.max-delay-seconds=60
jarvis.scheduling.max-duration-seconds=60

# Operational console logging. Audit JSONL remains independent.
jarvis.logging.level=INFO
jarvis.logging.console.enabled=true
jarvis.logging.request.lifecycle=true
jarvis.logging.ai.jev=true
jarvis.logging.ai.luna=true
jarvis.logging.tool.lifecycle=true
jarvis.logging.proactive.decisions=false
jarvis.logging.health.interval-seconds=30
