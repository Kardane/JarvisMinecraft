# JarvisMinecraft runtime policy settings for Fabric / NeoForge.
# Provider credentials remain in environment variables/system properties and
# are intentionally not stored here.
#
# List values use | as the separator.

# PASSIVE: wake-word/session only. ACTIVE: may initiate from allowed public chat.
jarvis.interaction.mode=PASSIVE
jarvis.interaction.wake-words=자비스|jarvis|재비스
# Match configured wake words anywhere in the message.
jarvis.interaction.wake-word.anywhere=true
# Allow one bounded typo; exact matches always take precedence.
jarvis.interaction.wake-word.fuzzy-enabled=true
jarvis.interaction.wake-word.max-edit-distance=1
# Fixed window from the initial invocation; follow-up candidates do not extend it.
# Wake-word-free messages inside this window are evaluated by Jev. Only clear
# continuations of the active JARVIS conversation receive a JARVIS response.
jarvis.interaction.follow-up-seconds=30
# Minimum Jev RESPOND confidence for a wake-word-free follow-up.
jarvis.interaction.follow-up-confidence-threshold=0.70

jarvis.interaction.audience.mode=OP
jarvis.interaction.audience.whitelist=
jarvis.interaction.audience.blacklist=

# ACTIVE-mode proactive settings.
jarvis.interaction.proactive.context-messages=12
# Server-wide cooldown after a proactive conversation starts.
jarvis.interaction.proactive.cooldown-seconds=15
# Minimum Jev START_CONVERSATION confidence.
jarvis.interaction.proactive.confidence-threshold=0.75

jarvis.model.name=gpt-6-luna
jarvis.model.reasoning.mode=AUTO
jarvis.model.reasoning.fallback=MEDIUM

# Optional operator-defined prompt context. Files remain under
# config/jarvisminecraft/{persona.md,knowledge/*.md}.
jarvis.personality.enabled=true
jarvis.knowledge.enabled=true
jarvis.knowledge.max-files=32
jarvis.knowledge.max-file-bytes=32768
jarvis.knowledge.max-total-bytes=131072

# Safe Minecraft formatting is supported in prefix, waiting messages,
# metrics.icon, and final Luna reply bodies.
# Configured fields support legacy & codes and <#RRGGBB> hex colors.
# Example: jarvis.response.prefix=<#FF00FF>[JARVIS]&r 
jarvis.response.prefix=[JARVIS] 
jarvis.response.waiting-message.enabled=true
jarvis.response.waiting-message.threshold-ms=1800
jarvis.response.waiting-message.messages=<#94A3B8>잠시만요.&r|<#7DD3FC>확인해볼게요.&r|<#94A3B8>서버 상태를 살펴보고 있어요.&r|<#7DD3FC>조금만 기다려 주세요.&r|<#94A3B8>요청을 확인하고 있어요.&r|<#7DD3FC>필요한 정보를 모으고 있어요.&r|<#94A3B8>서버 데이터를 확인 중이에요.&r|<#7DD3FC>관련 상태를 조회하고 있어요.&r|<#94A3B8>요청 내용을 정리하고 있어요.&r|<#7DD3FC>확인할 항목을 살펴보고 있어요.&r|<#94A3B8>잠깐 확인해볼게요.&r|<#7DD3FC>처리할 내용을 점검하고 있어요.&r|<#94A3B8>서버에서 확인 중이에요.&r|<#7DD3FC>필요한 상태를 불러오고 있어요.&r|<#94A3B8>요청을 처리하고 있어요.&r|<#7DD3FC>곧 답변드릴게요.&r

jarvis.response.sound.enabled=false
jarvis.response.sound.id=minecraft:block.note_block.pling
jarvis.response.sound.volume=1.0
jarvis.response.sound.pitch=1.0

# Hover-only final/error response metrics. The icon supports & formatting and
# <#RRGGBB> hex colors.
jarvis.response.metrics.enabled=true
jarvis.response.metrics.icon=<#7DD3FC>📊

# Optional persistent archive of direct/follow-up USER and JARVIS messages.
# Stored under config/jarvisminecraft/conversations/*.jsonl.
# Proactive ambient-chat context, Tool results, reasoning, prompts, and secrets
# are not archived.
jarvis.conversation-archive.enabled=true
jarvis.conversation-archive.max-file-bytes=1048576
jarvis.conversation-archive.max-files=30

# Previous-session conversation context is retrieved automatically.
# Reads previous-session archive records for the same requester UUID only.
# Enable conversation-archive as well to keep accumulating future memory.
jarvis.conversation-memory.enabled=true
jarvis.conversation-memory.lookback-days=30
jarvis.conversation-memory.max-source-files=4
jarvis.conversation-memory.max-turns=6
jarvis.conversation-memory.max-context-bytes=8192

# READ_TALK: read-only Tools only.
# EXECUTE_LITE: read-only + LOW-risk state-changing Tools enabled in tools.properties.
# EXECUTE: Tools enabled in tools.properties.
jarvis.execution.mode=READ_TALK
jarvis.execution.actors=OP

# Enables schedule_action. Pending schedules are memory-only.
jarvis.scheduling.enabled=true
jarvis.scheduling.max-delay-seconds=60
jarvis.scheduling.max-duration-seconds=60

# Operational console logging. Audit JSONL remains independent.
jarvis.logging.level=INFO
jarvis.logging.console.enabled=true
jarvis.logging.request.lifecycle=true
jarvis.logging.ai.jev=true
jarvis.logging.ai.luna=true
jarvis.logging.tool.lifecycle=true
jarvis.logging.proactive.decisions=false
jarvis.logging.health.interval-seconds=30
