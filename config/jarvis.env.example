# JARVIS Embedded Brain provider credentials.
# These are the only required JARVIS settings.
OPENAI_API_KEY=REPLACE_ME
TYPESAFE_API_KEY=REPLACE_ME

# Optional override. When omitted, JARVIS derives a stable local server ID
# from the platform data directory path. Existing server-id.txt is still read.
# JARVIS_SERVER_ID=my-server

# Audit logs are written by the Embedded Brain inside the Minecraft process.
# Paper: plugins/JarvisMinecraft/audit
# Fabric/NeoForge: config/jarvisminecraft/audit
