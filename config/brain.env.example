# JARVIS Brain provider credentials.
# Never put these in Paper/Fabric/NeoForge config files.
OPENAI_API_KEY=REPLACE_ME
TYPESAFE_API_KEY=REPLACE_ME

# Local Adapter <-> Brain shared secret.
# Use a random secret; the sample value is intentionally rejected.
JARVIS_SHARED_SECRET=REPLACE_WITH_RANDOM_SECRET

# Brain listener is loopback-only in v0.1.
JARVIS_BRAIN_HOST=127.0.0.1
JARVIS_BRAIN_PORT=8181

# Audit defaults: 7 days, 100 MiB total, 8 MiB/file, queue 512.
JARVIS_AUDIT_DIR=./logs/jarvis-audit
JARVIS_AUDIT_RETENTION_DAYS=7
JARVIS_AUDIT_MAX_TOTAL_BYTES=104857600
JARVIS_AUDIT_MAX_FILE_BYTES=8388608
JARVIS_AUDIT_MAX_QUEUE=512
