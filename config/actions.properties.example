# JarvisMinecraft command action policy example.
#
# The runtime creates actions.properties beside the main JARVIS config and
# automatically lists every command root currently registered by the server.
# New command roots are added as false. Change values only to true or false.
#
# Paper:
#   plugins/JarvisMinecraft/actions.properties
# Fabric / NeoForge:
#   config/jarvisminecraft/actions.properties
#
# Examples:
give=false
gamemode=false
teleport=false
execute=false
essentials:home=false
